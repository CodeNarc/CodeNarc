<ruleset xmlns="http://codenarc.org/ruleset/1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://codenarc.org/ruleset/1.0 http://codenarc.org/ruleset-schema.xsd"
        xsi:noNamespaceSchemaLocation="http://codenarc.org/ruleset-schema.xsd">

    <description>
        Spock rule set.
        These rules implement standards and best practices related to Spock specifications.
    </description>

    <rule class='org.codenarc.rule.spock.SpockIgnoreRestUsedRule'/>
    <rule class='org.codenarc.rule.spock.SpockMissingAssertRule'/>
    <rule class='org.codenarc.rule.spock.SpockMissingReasonRule'/>
    <rule class='org.codenarc.rule.spock.SpockUnnecessaryAssertRule'/>
    <rule class='org.codenarc.rule.spock.SpockUnnecessaryUnrollRule'/>
    <rule class='org.codenarc.rule.spock.SpockUseTempDirRule'/>
    <rule class='org.codenarc.rule.spock.SpockUseVerifyEachRule'/>

</ruleset>
